# Copy to .env and fill in.

# DataHub instance (local quickstart default shown)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# LLM provider for agent.py. Format: "<provider>:<model>"
#   anthropic:claude-sonnet-5 | openai:gpt-... | google_genai:gemini-...
AGENT_MODEL=anthropic:claude-sonnet-5

# Matching API key for whichever provider you set above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Snowflake — used by ingest.sh / snowflake_ingest.yml (real-Snowflake path).
# Account identifier: run `SELECT CURRENT_ACCOUNT(), CURRENT_REGION();` in
# Snowsight (see snowflake/01_setup.sql, step 5).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=DATAHUB_INGEST
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=

# Slack incoming webhook for the agent's alert tool (optional).
SLACK_WEBHOOK_URL=
